# ---- API ----
PORT=3000
# Base URL used in mock-post preview links
PUBLIC_BASE_URL=http://localhost:3000
# SQLite file (created automatically)
DB_FILE=./data/studio.db

# ---- Platforms & adapters ----
# Which platforms get a variant when you call POST /posts/:id/variants
PLATFORMS=x,linkedin,telegram
# platform=adapter. Swap an adapter by changing ONLY this line, e.g. telegram=mock_x
# Known adapters: telegram, discord, mock_x, mock_linkedin
ADAPTERS=x=mock_x,linkedin=mock_linkedin,telegram=telegram

# ---- Real target: Telegram (your OWN channel, bot must be admin) ----
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Public channel: @your_channel_name   Private channel: -100xxxxxxxxxx
TELEGRAM_CHAT_ID=@your_channel_name

# ---- Optional real target: Discord webhook (your OWN server) ----
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=

# ---- Worker ----
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF_MS=30000
PUBLISH_TIMEOUT_MS=15000

# ---- Failure simulation (leave empty in normal use) ----
# 1 = worker exits right AFTER the platform accepted a post, BEFORE saving the result
SIM_CRASH_AFTER_SEND=
# 1 = mock adapters store the post, then throw a "timeout" once (forces a retry)
SIM_MOCK_TIMEOUT_ONCE=
# Milliseconds to wait before each send (makes "stop the worker mid-batch" easy to demo)
SIM_SEND_DELAY_MS=0
